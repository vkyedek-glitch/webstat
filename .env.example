NODE_ENV=production
PORT=3000

# Genel erişim URL'i (kurulum snippet'inde kullanılır)
PUBLIC_URL=https://analytics.sirketiniz.com

DATABASE_URL=postgres://analytics:change_me@localhost:5432/analytics
# Boş bırakılırsa rate limit bellek içi çalışır (tek instance için yeterli)
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32   (en az 32 karakter zorunlu)
ADMIN_TOKEN=

# Dashboard web girişi (ADMIN_TOKEN'dan ayrı)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# openssl rand -hex 32 (bu anahtar olmadan SMTP parolası çözülemez)
SETTINGS_ENCRYPTION_KEY=

# Nginx/Cloudflare arkasında hop sayısı. Doğrudan internete açıksa "false".
# YANLIŞ değer, X-Forwarded-For sahteciliği ile rate-limit bypass'a yol açar.
TRUST_PROXY=1

# Panel farklı bir origin'de ise (stats/admin API için CORS)
DASHBOARD_ORIGIN=

# Gizlilik
RESPECT_DNT=true
SESSION_TIMEOUT_MIN=30
RETENTION_DAYS=365

# Rate limit (IP başına, pencere içinde)
TRACK_RATE_WINDOW_S=10
TRACK_RATE_MAX=60
API_RATE_WINDOW_S=60
API_RATE_MAX=120

# Yazma kuyruğu
BATCH_SIZE=500
FLUSH_INTERVAL_MS=1000
MAX_QUEUE=50000

# Coğrafi konum (opsiyonel): MaxMind GeoLite2-City.mmdb yolu
GEOIP_DB=
# veya CDN başlığı (yalnızca güvenilir CDN arkasındaysanız): CF-IPCountry
GEO_COUNTRY_HEADER=
